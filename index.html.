<title>Arpita Singh | Portfolio</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">

<style>
:root {
  --bg: #0d0d12;
  --card: #171720;
  --purple: #b9a3ff;
  --text: #f5f2ff;
  --muted: #aaa5b8;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'DM Sans', sans-serif;
  line-height: 1.7;
}

nav {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 9%;
  background: rgba(13,13,18,.92);
  backdrop-filter: blur(15px);
  border-bottom: 1px solid #292632;
}

.logo {
  font-family: 'Playfair Display', serif;
  font-size: 24px;
  color: var(--purple);
}

nav a {
  color: var(--muted);
  text-decoration: none;
  margin-left: 25px;
  font-size: 14px;
}

nav a:hover { color: var(--purple); }

section { padding: 95px 10%; }

.hero {
  min-height: 88vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background:
    radial-gradient(ellipse at 85% 25%, #55418b35, transparent 45%);
}

.tag {
  color: var(--purple);
  letter-spacing: 3px;
  font-size: 12px;
  text-transform: uppercase;
}

h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(48px, 8vw, 90px);
  line-height: 1.15;
  margin: 22px 0;
}

h1 span { color: var(--purple); font-style: italic; }

.hero p {
  max-width: 570px;
  color: var(--muted);
  font-size: 17px;
}

.btn {
  display: inline-block;
  margin-top: 30px;
  padding: 12px 25px;
  background: var(--purple);
  color: #171220;
  border-radius: 30px;
  text-decoration: none;
  font-weight: 700;
  transition: .3s;
}

.btn:hover { transform: translateY(-4px); }

.section-title {
  font-family: 'Playfair Display', serif;
  font-size: 42px;
  margin-bottom: 35px;
}

.section-title span { color: var(--purple); }

.about-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 35px;
}

.card {
  background: var(--card);
  border: 1px solid #302b3b;
  padding: 30px;
  border-radius: 18px;
  transition: .3s;
}

.card:hover {
  border-color: var(--purple);
  transform: translateY(-5px);
}

.card p { color: var(--muted); }

.card h3 {
  margin-bottom: 12px;
  color: var(--purple);
}

.skills {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.skill {
  background: #211c30;
  color: #d4c6ff;
  border: 1px solid #493d66;
  border-radius: 30px;
  padding: 10px 19px;
  font-size: 14px;
}

.timeline {
  border-left: 2px solid var(--purple);
  padding-left: 25px;
}

.timeline .card { margin-bottom: 20px; }

.project-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.project-number {
  font-family: 'Playfair Display', serif;
  color: var(--purple);
  font-size: 35px;
}

.contact {
  text-align: center;
  background: radial-gradient(ellipse at center, #4c387b35, transparent 65%);
}

.contact p { color: var(--muted); }

.contact-links {
  margin-top: 25px;
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
}

.contact-links a {
  color: var(--purple);
  text-decoration: none;
}

footer {
  text-align: center;
  padding: 25px;
  border-top: 1px solid #292632;
  color: var(--muted);
  font-size: 13px;
}

@media(max-width:700px) {
  nav { padding: 15px 5%; }
  nav a { margin-left: 10px; font-size: 12px; }
  section { padding: 70px 7%; }
  .about-grid, .project-grid { grid-template-columns: 1fr; }
  .section-title { font-size: 34px; }
}
</style>
</head>

